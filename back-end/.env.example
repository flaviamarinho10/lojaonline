# Copie este arquivo para .env e preencha com os seus valores

# Conexão com o PostgreSQL (no Supabase, use a porta 6543 do Pooler)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"

# Chave usada para assinar os tokens de login
JWT_SECRET="sua_chave_segura"

# Porta do servidor
PORT=3333
